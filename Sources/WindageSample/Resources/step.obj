# a stone step, used only by the second level: 3 m wide, 1 m deep, 1 m tall, standing on y = 0.
# Sunk into the ground by a placement's y offset so its top is at whatever height a stair needs —
# one mesh for every tread, because a level's scale is uniform and a tread is not a cube.
# UVs are in metres, like pillar.obj, so the stone is the same size on both.
mtllib step.mtl
v -1.5 0 -0.5
v 1.5 0 -0.5
v 1.5 0 0.5
v -1.5 0 0.5
v -1.5 1 -0.5
v -1.5 1 0.5
v 1.5 1 0.5
v 1.5 1 -0.5
v -1.5 0 -0.5
v -1.5 1 -0.5
v 1.5 1 -0.5
v 1.5 0 -0.5
v 1.5 0 0.5
v 1.5 1 0.5
v -1.5 1 0.5
v -1.5 0 0.5
v -1.5 0 -0.5
v -1.5 0 0.5
v -1.5 1 0.5
v -1.5 1 -0.5
v 1.5 0 -0.5
v 1.5 1 -0.5
v 1.5 1 0.5
v 1.5 0 0.5
vn 0 -1 0
vn 0 1 0
vn 0 0 -1
vn 0 0 1
vn -1 0 0
vn 1 0 0
vt -1.5 -0.5
vt 1.5 -0.5
vt 1.5 0.5
vt -1.5 0.5
vt -1.5 -0.5
vt -1.5 0.5
vt 1.5 0.5
vt 1.5 -0.5
vt -1.5 0
vt -1.5 1
vt 1.5 1
vt 1.5 0
vt 1.5 0
vt 1.5 1
vt -1.5 1
vt -1.5 0
vt 0 -0.5
vt 0 0.5
vt 1 0.5
vt 1 -0.5
vt 0 -0.5
vt 1 -0.5
vt 1 0.5
vt 0 0.5
usemtl stone
f 1/1/1 2/2/1 3/3/1 4/4/1
f 5/5/2 6/6/2 7/7/2 8/8/2
f 9/9/3 10/10/3 11/11/3 12/12/3
f 13/13/4 14/14/4 15/15/4 16/16/4
f 17/17/5 18/18/5 19/19/5 20/20/5
f 21/21/6 22/22/6 23/23/6 24/24/6
