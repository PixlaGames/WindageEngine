    def Material "Skin"
    {
        token outputs:surface.connect = </Figure/Skin/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Figure/Skin/Albedo.outputs:rgb>
            normal3f inputs:normal.connect = </Figure/Skin/Bump.outputs:rgb>
            float inputs:occlusion.connect = </Figure/Skin/ORM.outputs:r>
            float inputs:roughness.connect = </Figure/Skin/ORM.outputs:g>
            float inputs:metallic.connect = </Figure/Skin/ORM.outputs:b>
            color3f inputs:emissiveColor.connect = </Figure/Skin/Glow.outputs:rgb>
            token outputs:surface
        }

        def Shader "Glow"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @figure_emissive.png@
            float2 inputs:st.connect = </Figure/Skin/Reader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "ORM"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @figure_orm.png@
            float2 inputs:st.connect = </Figure/Skin/Reader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float outputs:r
            float outputs:g
            float outputs:b
        }

        def Shader "Bump"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @figure_normal.png@
            float2 inputs:st.connect = </Figure/Skin/Reader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "Albedo"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @figure.png@
            float2 inputs:st.connect = </Figure/Skin/Reader.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }

        def Shader "Reader"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
}
